<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#FFF8E7">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="숙제">
<link rel="manifest" href="manifest.json">
<link rel="apple-touch-icon" href="icon-192.png">
<title>숙제 체크리스트</title>
<link href="https://fonts.googleapis.com/css2?family=Gowun+Dodum&family=Gaegu:wght@400;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  
  body {
    font-family: 'Gowun Dodum', sans-serif;
    background: #FFF8E7;
    background-image: 
      radial-gradient(circle at 20% 30%, rgba(255, 200, 100, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(100, 200, 255, 0.15) 0%, transparent 50%);
    min-height: 100vh;
    padding: 20px 14px 40px;
    padding-top: max(20px, env(safe-area-inset-top));
    padding-bottom: max(40px, env(safe-area-inset-bottom));
    color: #3D2817;
  }
  
  .container { max-width: 480px; margin: 0 auto; }
  
  .header { text-align: center; margin-bottom: 16px; }
  
  .header h1 {
    font-family: 'Gaegu', cursive;
    font-size: 32px;
    font-weight: 700;
    letter-spacing: -1px;
  }
  
  .top-bar { display: flex; gap: 10px; margin-bottom: 18px; }
  
  .coin-display {
    flex: 1;
    background: linear-gradient(135deg, #FFD93D, #FFB84D);
    border: 3px solid #3D2817;
    border-radius: 16px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 4px 4px 0 #3D2817;
  }
  
  .coin-icon { font-size: 28px; animation: spin 4s linear infinite; }
  
  @keyframes spin {
    0%, 90%, 100% { transform: rotateY(0deg); }
    95% { transform: rotateY(360deg); }
  }
  
  .coin-amount { font-family: 'Gaegu', cursive; font-size: 26px; font-weight: 700; }
  .coin-label { font-family: 'Gaegu', cursive; font-size: 14px; color: #6B4423; margin-top: -4px; }
  
  .shop-btn {
    background: #C44536;
    border: 3px solid #3D2817;
    border-radius: 16px;
    padding: 10px 16px;
    font-family: 'Gaegu', cursive;
    font-size: 18px;
    color: white;
    cursor: pointer;
    box-shadow: 4px 4px 0 #3D2817;
    transition: transform 0.1s;
  }
  
  .shop-btn:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 #3D2817; }
  
  .calendar-card {
    background: white;
    border: 3px solid #3D2817;
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 20px;
    box-shadow: 4px 4px 0 #3D2817;
  }
  
  .cal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  
  .cal-nav {
    background: #FFE8B6;
    border: 2px solid #3D2817;
    border-radius: 10px;
    width: 36px;
    height: 36px;
    font-family: 'Gaegu', cursive;
    font-size: 20px;
    cursor: pointer;
    font-weight: 700;
  }
  
  .cal-title { font-family: 'Gaegu', cursive; font-size: 24px; font-weight: 700; }
  
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; }
  
  .cal-day-name {
    text-align: center;
    font-family: 'Gaegu', cursive;
    font-size: 14px;
    font-weight: 700;
    color: #8B6F47;
    padding: 4px 0;
  }
  
  .cal-day-name.sun { color: #C44536; }
  .cal-day-name.sat { color: #4A89C4; }
  
  .cal-cell {
    aspect-ratio: 1;
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-family: 'Gaegu', cursive;
    font-size: 16px;
    font-weight: 700;
    background: #FFF4D6;
    border: 2px solid transparent;
    position: relative;
    transition: all 0.15s;
  }
  
  .cal-cell:active { transform: scale(0.95); }
  .cal-cell.empty { background: transparent; cursor: default; }
  
  .cal-cell.today { border-color: #E07B39; background: #FFD93D; }
  .cal-cell.selected { background: #3D2817; color: #FFF8E7; border-color: #3D2817; }
  
  .cal-cell.has-tasks::after {
    content: '';
    position: absolute;
    bottom: 4px;
    width: 5px;
    height: 5px;
    background: #E07B39;
    border-radius: 50%;
  }
  
  .cal-cell.all-done::after { background: #6BAA75; }
  .cal-cell.selected.has-tasks::after { background: #FFD93D; }
  
  .cal-cell.sun { color: #C44536; }
  .cal-cell.sat { color: #4A89C4; }
  .cal-cell.selected.sun, .cal-cell.selected.sat { color: #FFF8E7; }
  
  .selected-date {
    text-align: center;
    margin-bottom: 14px;
    font-family: 'Gaegu', cursive;
    font-size: 22px;
    font-weight: 700;
  }
  
  .subject {
    background: white;
    border: 3px solid #3D2817;
    border-radius: 16px;
    margin-bottom: 12px;
    overflow: hidden;
    box-shadow: 4px 4px 0 #3D2817;
  }
  
  .subject-header {
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 2px dashed #D4B896;
  }
  
  .subject-icon { font-size: 24px; }
  .subject-name { font-family: 'Gaegu', cursive; font-size: 22px; font-weight: 700; flex: 1; }
  .subject-status { font-size: 13px; color: #8B6F47; }
  
  .task-list { padding: 6px 0; }
  
  .task {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    cursor: pointer;
    user-select: none;
  }
  
  .task:active { background: #FFF4D6; }
  
  .checkbox {
    width: 26px;
    height: 26px;
    border: 3px solid #3D2817;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    background: white;
    transition: all 0.2s;
  }
  
  .task.done .checkbox { background: #6BAA75; }
  .task.done .checkbox::after { content: '✓'; color: white; font-weight: bold; font-size: 18px; }
  
  .task-input {
    flex: 1;
    border: none;
    background: transparent;
    font-family: 'Gowun Dodum', sans-serif;
    font-size: 15px;
    color: #3D2817;
    outline: none;
    padding: 4px 0;
  }
  
  .task.done .task-input { text-decoration: line-through; color: #A8916D; }
  
  .delete-btn {
    background: none;
    border: none;
    color: #C44536;
    font-size: 18px;
    cursor: pointer;
    padding: 4px 8px;
    opacity: 0.5;
  }
  
  .add-btn {
    width: 100%;
    padding: 10px;
    background: #FFF4D6;
    border: none;
    border-top: 2px dashed #D4B896;
    font-family: 'Gaegu', cursive;
    font-size: 16px;
    color: #8B6F47;
    cursor: pointer;
  }
  
  .add-btn:active { background: #FFE8B6; color: #3D2817; }
  
  .dog-reward {
    position: fixed;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(200px);
    background: white;
    border: 4px solid #3D2817;
    border-radius: 20px;
    padding: 16px 24px;
    box-shadow: 6px 6px 0 #3D2817;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 200;
    max-width: 320px;
  }
  
  .dog-reward.show { transform: translateX(-50%) translateY(0); }
  
  .dog-face { font-size: 40px; animation: wiggle 0.5s ease infinite; }
  
  @keyframes wiggle {
    0%, 100% { transform: rotate(-8deg); }
    50% { transform: rotate(8deg); }
  }
  
  .dog-msg { font-family: 'Gaegu', cursive; font-size: 18px; font-weight: 700; line-height: 1.3; }
  
  .flying-coin {
    position: fixed;
    font-size: 32px;
    z-index: 199;
    pointer-events: none;
    transition: all 0.8s cubic-bezier(0.5, -0.5, 0.5, 1);
  }
  
  .modal-bg {
    position: fixed;
    inset: 0;
    background: rgba(61, 40, 23, 0.6);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 300;
    padding: 20px;
  }
  
  .modal-bg.show { display: flex; }
  
  .modal {
    background: #FFF8E7;
    border: 4px solid #3D2817;
    border-radius: 20px;
    padding: 24px;
    max-width: 380px;
    width: 100%;
    box-shadow: 8px 8px 0 #3D2817;
    max-height: 85vh;
    overflow-y: auto;
  }
  
  .modal-title { font-family: 'Gaegu', cursive; font-size: 28px; font-weight: 700; text-align: center; margin-bottom: 8px; }
  .modal-sub { text-align: center; margin-bottom: 20px; font-family: 'Gaegu', cursive; font-size: 18px; color: #E07B39; }
  
  .shop-item {
    background: white;
    border: 3px solid #3D2817;
    border-radius: 14px;
    padding: 14px;
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 3px 3px 0 #3D2817;
  }
  
  .shop-item-icon { font-size: 36px; }
  .shop-item-info { flex: 1; }
  .shop-item-name { font-family: 'Gaegu', cursive; font-size: 20px; font-weight: 700; }
  .shop-item-price { font-family: 'Gaegu', cursive; font-size: 16px; color: #E07B39; }
  
  .buy-btn {
    background: #6BAA75;
    border: 2px solid #3D2817;
    color: white;
    font-family: 'Gaegu', cursive;
    font-size: 16px;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 10px;
    cursor: pointer;
    box-shadow: 2px 2px 0 #3D2817;
  }
  
  .buy-btn:disabled { background: #B8B8B8; cursor: not-allowed; }
  
  .modal-close {
    width: 100%;
    margin-top: 8px;
    padding: 10px;
    background: #3D2817;
    color: white;
    border: none;
    border-radius: 10px;
    font-family: 'Gaegu', cursive;
    font-size: 18px;
    cursor: pointer;
  }
  
  .owned-tickets {
    background: #FFE8B6;
    border: 2px dashed #8B6F47;
    border-radius: 12px;
    padding: 10px;
    margin-bottom: 16px;
  }
  
  .owned-title { font-family: 'Gaegu', cursive; font-size: 16px; font-weight: 700; margin-bottom: 6px; color: #6B4423; }
  .owned-list { font-family: 'Gaegu', cursive; font-size: 15px; }
  .owned-empty { color: #A8916D; font-style: italic; }
  
  .toast {
    position: fixed;
    top: 30px;
    left: 50%;
    transform: translateX(-50%) translateY(-100px);
    background: #6BAA75;
    color: white;
    padding: 14px 24px;
    border: 3px solid #3D2817;
    border-radius: 14px;
    font-family: 'Gaegu', cursive;
    font-size: 18px;
    font-weight: 700;
    box-shadow: 4px 4px 0 #3D2817;
    transition: transform 0.4s;
    z-index: 400;
  }
  
  .toast.show { transform: translateX(-50%) translateY(0); }
  
  .sound-toggle {
    position: fixed;
    top: 20px;
    right: 20px;
    background: white;
    border: 2px solid #3D2817;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-size: 18px;
    cursor: pointer;
    z-index: 50;
    box-shadow: 2px 2px 0 #3D2817;
  }
</style>
</head>
<body>

<button class="sound-toggle" id="soundToggle" onclick="toggleSound()">🔊</button>

<div class="container">
  <div class="header">
    <h1>📚 숙제 체크리스트</h1>
  </div>
  
  <div class="top-bar">
    <div class="coin-display">
      <span class="coin-icon">🪙</span>
      <div>
        <div class="coin-amount" id="coinAmount">0</div>
        <div class="coin-label">내 코인</div>
      </div>
    </div>
    <button class="shop-btn" onclick="openShop()">🎁<br>상점</button>
  </div>
  
  <div class="calendar-card">
    <div class="cal-header">
      <button class="cal-nav" onclick="changeMonth(-1)">‹</button>
      <div class="cal-title" id="calTitle"></div>
      <button class="cal-nav" onclick="changeMonth(1)">›</button>
    </div>
    <div class="cal-grid" id="calGrid"></div>
  </div>
  
  <div class="selected-date" id="selectedDate"></div>
  
  <div id="subjects"></div>
</div>

<div class="dog-reward" id="dogReward">
  <div class="dog-face">🐶</div>
  <div class="dog-msg" id="dogMsg"></div>
</div>

<div class="modal-bg" id="shopModal" onclick="if(event.target===this)closeShop()">
  <div class="modal">
    <div class="modal-title">🎁 코인 상점</div>
    <div class="modal-sub">내 코인: <span id="modalCoin">0</span> 🪙</div>
    
    <div class="owned-tickets">
      <div class="owned-title">🎟️ 보유 이용권</div>
      <div class="owned-list" id="ownedList"></div>
    </div>
    
    <div class="shop-item">
      <span class="shop-item-icon">🥓</span>
      <div class="shop-item-info">
        <div class="shop-item-name">삼겹살 먹기 이용권</div>
        <div class="shop-item-price">30 🪙</div>
      </div>
      <button class="buy-btn" id="buy-samgyup" onclick="buyItem('samgyup', 30, '🥓 삼겹살 이용권')">구매</button>
    </div>
    
    <div class="shop-item">
      <span class="shop-item-icon">🎮</span>
      <div class="shop-item-info">
        <div class="shop-item-name">PC방 이용권</div>
        <div class="shop-item-price">20 🪙</div>
      </div>
      <button class="buy-btn" id="buy-pcbang" onclick="buyItem('pcbang', 20, '🎮 PC방 이용권')">구매</button>
    </div>
    
    <button class="modal-close" onclick="closeShop()">닫기</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
/* ====== 사운드 (Web Audio API - 파일 불필요) ====== */
let audioCtx = null;
let soundOn = true;

function initAudio() {
  if (!audioCtx) {
    try {
      audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    } catch(e) {}
  }
  if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
}

function playTone(freq, duration, type = 'sine', volume = 0.15) {
  if (!soundOn) return;
  initAudio();
  if (!audioCtx) return;
  
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = type;
  osc.frequency.value = freq;
  gain.gain.setValueAtTime(volume, audioCtx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.start();
  osc.stop(audioCtx.currentTime + duration);
}

function soundCheck() {
  // 띵! - 높은 음 한 번
  playTone(1200, 0.15, 'sine', 0.2);
  setTimeout(() => playTone(1600, 0.2, 'sine', 0.15), 80);
}

function soundCoin() {
  // 짤랑 - 동전 소리
  playTone(800, 0.08, 'square', 0.1);
  setTimeout(() => playTone(1200, 0.1, 'square', 0.1), 60);
  setTimeout(() => playTone(1600, 0.15, 'square', 0.08), 120);
}

function soundFanfare() {
  // 팡파레 - 구매 완료
  const notes = [523, 659, 784, 1047]; // C E G C
  notes.forEach((f, i) => {
    setTimeout(() => playTone(f, 0.2, 'triangle', 0.18), i * 100);
  });
}

function soundBonus() {
  // 보너스 - 상승 멜로디
  const notes = [523, 659, 784, 880, 1047];
  notes.forEach((f, i) => {
    setTimeout(() => playTone(f, 0.15, 'sine', 0.15), i * 80);
  });
}

function soundClick() {
  playTone(600, 0.05, 'sine', 0.08);
}

function toggleSound() {
  soundOn = !soundOn;
  document.getElementById('soundToggle').textContent = soundOn ? '🔊' : '🔇';
  localStorage.setItem('soundOn', soundOn);
  if (soundOn) soundClick();
}

/* ====== 데이터 ====== */
const SUBJECTS = [
  { id: 'math', name: '수학', icon: '🔢' },
  { id: 'science', name: '과학', icon: '🔬' },
  { id: 'calc', name: '연산', icon: '➕' },
  { id: 'social', name: '사회', icon: '🌏' }
];

const STORAGE_KEY = 'hw-app-v1';

let state = {
  tasks: {},
  coins: 0,
  tickets: {},
  bonusGiven: {}
};

let viewYear, viewMonth, selectedDate;

function dateKey(y, m, d) {
  return `${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
}

function todayKey() {
  const t = new Date();
  return dateKey(t.getFullYear(), t.getMonth(), t.getDate());
}

function load() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) state = JSON.parse(raw);
  } catch (e) {}
  
  if (!state.tasks) state.tasks = {};
  if (!state.tickets) state.tickets = {};
  if (!state.bonusGiven) state.bonusGiven = {};
  if (typeof state.coins !== 'number') state.coins = 0;
  
  const savedSound = localStorage.getItem('soundOn');
  if (savedSound !== null) {
    soundOn = savedSound === 'true';
    document.getElementById('soundToggle').textContent = soundOn ? '🔊' : '🔇';
  }
  
  const t = new Date();
  viewYear = t.getFullYear();
  viewMonth = t.getMonth();
  selectedDate = todayKey();
  
  ensureDay(selectedDate);
  renderAll();
}

function save() {
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  } catch (e) {}
}

function ensureDay(key) {
  if (!state.tasks[key]) state.tasks[key] = {};
  SUBJECTS.forEach(s => {
    if (!state.tasks[key][s.id]) state.tasks[key][s.id] = [];
    if (state.tasks[key][s.id].length === 0) {
      state.tasks[key][s.id].push({ text: '숙제 내용 입력...', done: false });
    }
  });
}

function getDayStats(key) {
  const day = state.tasks[key];
  if (!day) return { done: 0, total: 0 };
  let done = 0, total = 0;
  SUBJECTS.forEach(s => {
    const list = day[s.id] || [];
    total += list.length;
    done += list.filter(t => t.done).length;
  });
  return { done, total };
}

function renderAll() {
  renderCalendar();
  renderTasks();
  renderCoins();
}

function renderCoins() {
  document.getElementById('coinAmount').textContent = state.coins;
  document.getElementById('modalCoin').textContent = state.coins;
}

function renderCalendar() {
  const monthNames = ['1월','2월','3월','4월','5월','6월','7월','8월','9월','10월','11월','12월'];
  document.getElementById('calTitle').textContent = `${viewYear}년 ${monthNames[viewMonth]}`;
  
  const grid = document.getElementById('calGrid');
  grid.innerHTML = '';
  
  const dayNames = ['일','월','화','수','목','금','토'];
  dayNames.forEach((n, i) => {
    const el = document.createElement('div');
    el.className = 'cal-day-name';
    if (i === 0) el.classList.add('sun');
    if (i === 6) el.classList.add('sat');
    el.textContent = n;
    grid.appendChild(el);
  });
  
  const firstDay = new Date(viewYear, viewMonth, 1).getDay();
  const lastDate = new Date(viewYear, viewMonth + 1, 0).getDate();
  const today = todayKey();
  
  for (let i = 0; i < firstDay; i++) {
    const el = document.createElement('div');
    el.className = 'cal-cell empty';
    grid.appendChild(el);
  }
  
  for (let d = 1; d <= lastDate; d++) {
    const key = dateKey(viewYear, viewMonth, d);
    const cell = document.createElement('div');
    cell.className = 'cal-cell';
    
    const dow = new Date(viewYear, viewMonth, d).getDay();
    if (dow === 0) cell.classList.add('sun');
    if (dow === 6) cell.classList.add('sat');
    
    if (key === today) cell.classList.add('today');
    if (key === selectedDate) cell.classList.add('selected');
    
    const stats = getDayStats(key);
    if (stats.total > 0 && state.tasks[key]) {
      const hasReal = SUBJECTS.some(s => 
        (state.tasks[key][s.id] || []).some(t => t.text !== '숙제 내용 입력...' || t.done)
      );
      if (hasReal) {
        cell.classList.add('has-tasks');
        if (stats.done === stats.total) cell.classList.add('all-done');
      }
    }
    
    cell.innerHTML = `<span class="day-num">${d}</span>`;
    cell.onclick = () => { soundClick(); selectDate(key); };
    grid.appendChild(cell);
  }
}

function selectDate(key) {
  selectedDate = key;
  ensureDay(key);
  renderAll();
}

function changeMonth(delta) {
  soundClick();
  viewMonth += delta;
  if (viewMonth < 0) { viewMonth = 11; viewYear--; }
  if (viewMonth > 11) { viewMonth = 0; viewYear++; }
  renderCalendar();
}

function renderTasks() {
  const [y, m, d] = selectedDate.split('-').map(Number);
  const dt = new Date(y, m-1, d);
  const days = ['일','월','화','수','목','금','토'];
  document.getElementById('selectedDate').textContent = 
    `📅 ${m}월 ${d}일 (${days[dt.getDay()]})`;
  
  const container = document.getElementById('subjects');
  container.innerHTML = '';
  
  SUBJECTS.forEach(s => {
    const tasks = state.tasks[selectedDate][s.id];
    const done = tasks.filter(t => t.done).length;
    
    const sEl = document.createElement('div');
    sEl.className = 'subject';
    sEl.innerHTML = `
      <div class="subject-header">
        <span class="subject-icon">${s.icon}</span>
        <span class="subject-name">${s.name}</span>
        <span class="subject-status">${done}/${tasks.length}</span>
      </div>
      <div class="task-list" id="list-${s.id}"></div>
      <button class="add-btn" onclick="addTask('${s.id}')">+ 숙제 추가</button>
    `;
    container.appendChild(sEl);
    
    const list = sEl.querySelector(`#list-${s.id}`);
    tasks.forEach((task, idx) => {
      const tEl = document.createElement('div');
      tEl.className = 'task' + (task.done ? ' done' : '');
      tEl.innerHTML = `
        <div class="checkbox" onclick="toggleTask('${s.id}',${idx}, this)"></div>
        <input type="text" class="task-input" value="${esc(task.text)}" 
               onchange="updateText('${s.id}',${idx},this.value)"
               onfocus="this.select()">
        <button class="delete-btn" onclick="deleteTask('${s.id}',${idx})">✕</button>
      `;
      list.appendChild(tEl);
    });
  });
}

function esc(s) {
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function toggleTask(subjectId, idx, checkboxEl) {
  const task = state.tasks[selectedDate][subjectId][idx];
  const wasDone = task.done;
  task.done = !task.done;
  
  if (!wasDone && task.done) {
    soundCheck();
    setTimeout(() => soundCoin(), 200);
    giveCoin(checkboxEl, 1, '잘했어! +1 🪙');
    
    setTimeout(() => {
      const stats = getDayStats(selectedDate);
      if (stats.done === stats.total && stats.total > 0 && !state.bonusGiven[selectedDate]) {
        state.bonusGiven[selectedDate] = true;
        soundBonus();
        giveCoin(null, 5, '🎉 하루 끝! 보너스 +5 🪙');
        save();
      }
    }, 700);
  } else {
    soundClick();
  }
  
  save();
  renderAll();
}

function giveCoin(fromEl, amount, msg) {
  state.coins += amount;
  
  const dogReward = document.getElementById('dogReward');
  document.getElementById('dogMsg').innerHTML = msg;
  dogReward.classList.add('show');
  setTimeout(() => dogReward.classList.remove('show'), 2200);
  
  if (fromEl) {
    const rect = fromEl.getBoundingClientRect();
    const coinDisplay = document.querySelector('.coin-display').getBoundingClientRect();
    
    for (let i = 0; i < Math.min(amount, 3); i++) {
      setTimeout(() => {
        const coin = document.createElement('div');
        coin.className = 'flying-coin';
        coin.textContent = '🪙';
        coin.style.left = rect.left + 'px';
        coin.style.top = rect.top + 'px';
        document.body.appendChild(coin);
        
        requestAnimationFrame(() => {
          coin.style.left = coinDisplay.left + 'px';
          coin.style.top = coinDisplay.top + 'px';
          coin.style.transform = 'scale(0.5) rotate(720deg)';
          coin.style.opacity = '0';
        });
        
        setTimeout(() => coin.remove(), 900);
      }, i * 100);
    }
  }
  
  renderCoins();
}

function updateText(subjectId, idx, text) {
  state.tasks[selectedDate][subjectId][idx].text = text;
  save();
}

function addTask(subjectId) {
  soundClick();
  state.tasks[selectedDate][subjectId].push({ text: '새 숙제', done: false });
  delete state.bonusGiven[selectedDate];
  save();
  renderTasks();
  setTimeout(() => {
    const list = document.getElementById(`list-${subjectId}`);
    const inputs = list.querySelectorAll('.task-input');
    const last = inputs[inputs.length - 1];
    if (last) { last.focus(); last.select(); }
  }, 50);
}

function deleteTask(subjectId, idx) {
  soundClick();
  state.tasks[selectedDate][subjectId].splice(idx, 1);
  if (state.tasks[selectedDate][subjectId].length === 0) {
    state.tasks[selectedDate][subjectId].push({ text: '숙제 내용 입력...', done: false });
  }
  save();
  renderAll();
}

function openShop() {
  soundClick();
  renderOwned();
  updateBuyButtons();
  document.getElementById('shopModal').classList.add('show');
}

function closeShop() {
  soundClick();
  document.getElementById('shopModal').classList.remove('show');
}

function renderOwned() {
  const ownedEl = document.getElementById('ownedList');
  const items = [];
  if (state.tickets.samgyup > 0) items.push(`🥓 삼겹살 ${state.tickets.samgyup}장`);
  if (state.tickets.pcbang > 0) items.push(`🎮 PC방 ${state.tickets.pcbang}장`);
  
  if (items.length === 0) {
    ownedEl.innerHTML = '<span class="owned-empty">아직 없어요. 코인 모으자!</span>';
  } else {
    ownedEl.textContent = items.join(' · ');
  }
}

function updateBuyButtons() {
  document.getElementById('buy-samgyup').disabled = state.coins < 30;
  document.getElementById('buy-pcbang').disabled = state.coins < 20;
}

function buyItem(id, price, name) {
  if (state.coins < price) return;
  state.coins -= price;
  state.tickets[id] = (state.tickets[id] || 0) + 1;
  save();
  soundFanfare();
  renderCoins();
  renderOwned();
  updateBuyButtons();
  showToast(`🎉 ${name} 구매 완료!`);
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2000);
}

// PWA 서비스 워커 등록
if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('service-worker.js').catch(()=>{});
  });
}

// 첫 터치에 오디오 활성화 (모바일)
document.addEventListener('touchstart', initAudio, { once: true });
document.addEventListener('click', initAudio, { once: true });

load();
</script>

